datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  role         String    @default("admin") // "admin" or "pengunjung"
  profilePhoto String?   @map("profile_photo")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Berita {
  id        Int        @id @default(autoincrement())
  instansi  String
  pembuat   String
  judul     String
  isi       String     @db.Text
  kategori  String
  status    String     @default("Published")
  views     Int        @default(0)
  gambar    String?
  isUtama   Boolean    @default(false) @map("is_utama")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  komentars Komentar[]

  @@map("berita")
}

model Komentar {
  id        Int      @id @default(autoincrement())
  beritaId  Int      @map("berita_id")
  nama      String
  isi       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  berita    Berita   @relation(fields: [beritaId], references: [id], onDelete: Cascade)

  @@map("komentars")
}

model SurveiPengunjung {
  id        Int      @id @default(autoincrement())
  nama      String
  q1        String
  q2        String
  q3        String
  q4        String
  q5        String
  q6        String
  q7        String
  q8        String
  q9        String
  q10       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("survei_pengunjungs")
}
